# Copy to .env.local. Only the public anon key belongs here; never put a service-role key in a VITE_ variable.
# Without these the site still works; the owner media panel and the enquiry form are simply disabled.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
